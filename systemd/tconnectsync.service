[Unit]
Description=Tandem tconnectsync to Nightscout
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tconnectsync
Group=tconnectsync
EnvironmentFile=/etc/tconnectsync/tconnectsync.env
Environment=HOME=/var/lib/tconnectsync
WorkingDirectory=/var/lib/tconnectsync
StateDirectory=tconnectsync
StateDirectoryMode=0700
ExecStartPre=/opt/tconnectsync/venv/bin/python /usr/local/libexec/tconnectsync/check-config.py
ExecStart=/opt/tconnectsync/venv/bin/tconnectsync --auto-update
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
