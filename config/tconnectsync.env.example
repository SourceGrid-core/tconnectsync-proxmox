# Copy this file to /etc/tconnectsync/tconnectsync.env on the LXC.
# Keep the installed file root:tconnectsync, mode 0640. Never commit real values.
TCONNECT_EMAIL=
TCONNECT_PASSWORD=
TCONNECT_REGION=US
NS_URL=
NS_SECRET=
TIMEZONE_NAME=America/New_York
# Optional; numeric pump serial number:
# PUMP_SERIAL_NUMBER=
